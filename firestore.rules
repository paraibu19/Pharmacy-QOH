rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ahmedmohammedsalah@gmail.com' ||
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    // Medication Collection
    match /medications/{medId} {
      allow read, write: if true;
    }

    // System Collection (for metadata sync)
    match /system/{docId} {
      allow read, write: if true;
    }

    // Inventory Audit Collection
    match /inventory_audits/{auditId} {
      allow read, write: if true;
    }

    // Admins Collection (Only if needed to add more admins manually)
    match /admins/{userId} {
      allow read, write: if true;
    }

    // Settings Collection
    match /settings/{docId} {
      allow read, write: if true;
    }

    match /app_settings/{docId} {
      allow read, write: if true;
    }

    match /entry_mistakes_configs/{docId} {
      allow read, write: if true;
    }

    match /entry_mistakes_parameters/{docId} {
      allow read, write: if true;
    }

    // Translation Cache Collection
    match /translation_cache/{cacheId} {
      allow read, write: if true;
    }

    // Application Storage Collection
    match /application_storage/{storageId} {
      allow read, write: if true;
    }

    // Item Reference Registry Collection
    match /item_reference_registry/{docId} {
      allow read, write: if true;
    }
  }
}
