rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "ahmedmohammedsalah@gmail.com" ||
        request.auth.token.email.endsWith("@gmail.com") ||
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        request.auth.providerId == 'anonymous'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    // Medication Collection
    match /medications/{medId} {
      function isValidMedication(data) {
        return data.keys().hasAll(['itemCode', 'itemName', 'qoh', 'locationId']) &&
               data.itemCode is string && data.itemCode.size() <= 100 &&
               data.itemName is string && data.itemName.size() <= 200 &&
               data.qoh is number &&
               data.locationId in ['adult-emergency', 'pediatric', 'mesaieed-opd'] &&
               (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000000)); // Allow large for base64
      }

      allow read: if true; // Public read as requested for sharing
      
      allow create: if isAdmin() && isValidId(medId) && isValidMedication(incoming());

      allow update: if isAdmin() && isValidMedication(incoming()) &&
                    incoming().itemCode == existing().itemCode; // Immutable itemCode

      allow delete: if isAdmin();
    }

    // Inventory Audit Collection
    match /inventory_audits/{auditId} {
      function isValidAudit(data) {
        return data.keys().hasAll(['itemCode', 'locationId', 'physicalCount', 'auditedAt']) &&
               data.itemCode is string && data.itemCode.size() <= 100 &&
               data.locationId is string &&
               data.physicalCount is number &&
               data.auditedAt is timestamp;
      }

      allow read: if isAdmin();
      
      allow create: if isAdmin() && isValidId(auditId) && isValidAudit(incoming()) &&
                    incoming().auditedBy == request.auth.uid &&
                    exists(/databases/$(database)/documents/medications/$(incoming().itemCode)); // Relational check

      // Audits are usually immutable logs
      allow update, delete: if false;
    }

    // Admins Collection (Only if needed to add more admins manually)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console or owner email
    }
  }
}
