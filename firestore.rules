rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ahmedmohammedsalah@gmail.com' ||
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    // Medication Collection
    match /medications/{medId} {
      function isValidMedication(data) {
        return data.keys().hasAll(['itemCode', 'itemName', 'qoh', 'locationId']) &&
               data.itemCode is string && data.itemCode.size() <= 100 &&
               data.itemName is string && data.itemName.size() <= 200 &&
               data.qoh is number &&
               data.locationId in ['adult-emergency', 'pediatric', 'mesaieed-opd'] &&
               (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000000)) &&
               (!('isRefrigerated' in data) || data.isRefrigerated is bool);
      }

      function isAuthorizedWrite() {
        // Allow if signed in OR if it's a "system" update (fallback for when anonymous auth is not yet enabled)
        return isSignedIn() || (incoming().updatedBy == 'system');
      }

      allow read, get, list: if true;
      
      allow create: if isAuthorizedWrite() && isValidId(medId) && isValidMedication(incoming()) &&
                    (request.auth != null ? incoming().updatedBy == request.auth.uid : true);

      allow update: if isAuthorizedWrite() && isValidMedication(incoming()) &&
                    (request.auth != null ? incoming().updatedBy == request.auth.uid : true) &&
                    incoming().itemCode == existing().itemCode;

      allow delete: if true; 
    }

    // Inventory Audit Collection
    match /inventory_audits/{auditId} {
      function isValidAudit(data) {
        return data.keys().hasAll(['itemCode', 'locationId', 'physicalCount', 'auditedAt']) &&
               data.itemCode is string && data.itemCode.size() <= 100 &&
               data.locationId is string &&
               data.physicalCount is number &&
               data.auditedAt is timestamp;
      }

      function isAuthorizedAudit() {
        return isSignedIn() || (incoming().auditedBy == 'system' || incoming().auditedBy is string);
      }

      allow read, get, list: if true;
      
      allow create: if isAuthorizedAudit() && isValidId(auditId) && isValidAudit(incoming()) &&
                    (request.auth != null ? incoming().auditedBy == request.auth.uid : true) &&
                    exists(/databases/$(database)/documents/medications/$(incoming().itemCode));

      allow delete: if true;
      allow update: if false;
    }

    // Admins Collection (Only if needed to add more admins manually)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console or owner email
    }

    // Settings Collection
    match /settings/{docId} {
      function isValidSetting(data) {
        return data.keys().hasAll(['password']) &&
               data.password is string && data.password.size() >= 4 && data.password.size() <= 64;
      }

      // Read is needed for portal login pages before auth
      allow read: if docId in ['pharmacist_portal', 'order_portal'];
      
      // Update from portals or admin dashboard
      allow update: if (isSignedIn() || (docId in ['pharmacist_portal', 'order_portal'])) && 
                    isValidSetting(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['password', 'updatedAt']);
      
      // Create if it doesn't exist
      allow create: if isSignedIn() && isValidSetting(incoming());
    }
  }
}
